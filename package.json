{
  "name": "paper-mind",
  "version": "1.6.0",
  "private": true,
  "description": "Find saved papers through the concepts you remember: existing tags, one-line memories, reading progress, local CLI and API models.",
  "license": "Apache-2.0",
  "author": "Wenqi Zhang",
  "homepage": "https://github.com/ZJU-OmniAI/Paper_Mind",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZJU-OmniAI/Paper_Mind.git"
  },
  "bugs": {
    "url": "https://github.com/ZJU-OmniAI/Paper_Mind/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "paper-management",
    "web-clipper",
    "local-first",
    "research-tools"

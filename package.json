{
  "name": "paper-mind",
  "version": "1.4.0",
  "private": true,
  "description": "A tag-based library for the papers you collect: one-click capture, tags and topic packs, local and LLM search, recommendations from your own collection.",
  "license": "Apache-2.0",
  "author": "Wenqi Zhang",
  "homepage": "https://github.com/ZJU-OmniAI/Paper_Mind",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZJU-OmniAI/Paper_Mind.git"
  },
  "bugs": {
    "url": "https://github.com/ZJU-OmniAI/Paper_Mind/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "paper-management",
    "web-clipper",
    "local-first",
    "research-tools"
  ],
  "type": "module",
  "scripts": {
    "package:extension": "node scripts/package-extension.mjs",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5"
  }
